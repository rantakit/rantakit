{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rantakit",
  "version": "0.4.1",
  "identifier": "com.rantakit",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rantakit",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3Qjc3ODcxREM5OTA2NEUKUldST0JwbmNjWGkzWnhNTzdaVDBISzhBbXJEZmtzdWVmcEtKWU1XT2VxTEpCQmNBeXllKzF2VUMK",
      "endpoints": ["https://github.com/moez-rd/rantakit/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "android": {
      "minSdkVersion": 26
    },
    "active": true,
    "targets": "all",
    "publisher": "moez-rd",
    "copyright": "Copyright © 2026 moez-rd",
    "category": "Utility",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/moez-rd/rantakit",
    "shortDescription": "Free, open-source file toolkit that works offline",
    "longDescription": "Rantakit keeps your file tools in one place: compress files, convert formats, work with PDFs, scan documents and extract text from images. Everything runs on your device, so it works without an internet connection.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}