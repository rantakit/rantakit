<?xml version="1.0" encoding="utf-8"?>
<!-- The blue-indigo gradient of the app icon, filling the whole shape the launcher
     cuts. It runs across the middle 72 dp the launcher shows. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0" android:color="#FF5470D9" />
                <item android:offset="1" android:color="#FF33419E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
